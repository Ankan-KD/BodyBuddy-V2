# ════════════════════════════════════════════════════════════════════════
# BodyBuddy — Docker environment template
#
# Copy this file to `.env.local` (same file the app already uses for local
# `npm run dev`) and fill in real values. docker-compose.yml reads it both
# as build args (for the NEXT_PUBLIC_* values, which get baked into the
# client bundle) and as the container's runtime environment (everything
# else). Never commit the filled-in `.env.local` — it's already git-
# ignored.
# ════════════════════════════════════════════════════════════════════════

# ── Supabase — Authentication & Database ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never exposed to the browser. Required for checkout,
# password/OTP routes, and other server-side database operations.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Gemini — AI Quick Log (optional; app works without it) ─────────
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_ENABLE_SEARCH_GROUNDING=false

# ── Razorpay — BB Store Checkout ───────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Resend — 6-digit email OTP delivery ────────────────────────────────────
RESEND_API_KEY=

# ── Docker Compose — host port mapping (optional) ──────────────────────────
APP_PORT=3000
